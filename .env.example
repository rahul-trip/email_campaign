# Copy to .env (git-ignored) and fill in. Blank means "not configured".
# Until the legacy agent/ package is deleted in Phase 2, agent/.env is also read as a fallback.

# --- database: flip DATABASE_BACKEND between the two; production uses postgres (Supabase) ---
DATABASE_BACKEND=sqlite
SQLITE_PATH=outbound.db
POSTGRES_URL=
# DATABASE_POOL_SIZE=5
# DATABASE_URL=     # set only to bypass the switch

# --- email waterfall providers (chain below is PROVISIONAL until the Phase 0 bake-off) ---
HUNTER_API_KEY=
ZEROBOUNCE_API_KEY=
ORBISEARCH_API_KEY=            # verifier only: OrbiSearch has no finder API
MYEMAILVERIFIER_API_KEY=
ENRICHLEY_API_KEY=             # catch-all resolver, answers in real time
SCRUBBY_API_KEY=               # catch-all resolver, answers in 24 to 72 hours
SCRUBBY_BASE_URL=              # not stated in Scrubby's public docs; copy it from your account

# --- search and research ---
TAVILY_API_KEY=
COMPANIES_HOUSE_API_KEY=       # free; confirms whether a UK lead is a registered company

# --- chain choice (comma-separated finders are tried in order) ---
FINDER_CHAIN=hunter,zerobounce
VERIFIER=myemailverifier
CATCH_ALL_RESOLVER=scrubby

# --- language model (any OpenAI-compatible endpoint) ---
# LLM_PROVIDER: anthropic | openai | gemini | ollama | github_copilot | openai_compatible
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5-5
LLM_BASE_URL=                  # only for openai_compatible (OpenRouter, Groq, Together, ...) or a proxy
# LLM_MAX_TOKENS=4000          # reasoning models think before answering; too low cuts the reply off
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
COPILOT_API_KEY=
LLM_API_KEY=                   # for openai_compatible, or as a fallback for the others

# --- mailbox (IMAP): where drafts are saved and Sent is read. Same names as the legacy agent/.env ---
IMAP_HOST=imap.hostinger.com
EMAIL_ADDRESS=
EMAIL_PASSWORD=
FROM_NAME=
DRAFTS_FOLDER=INBOX.Drafts
SENT_FOLDER=INBOX.Sent

# --- web app ---
# Make the hash with: uv run outbound auth hash-password
OPERATOR_PASSWORD_HASH=
SESSION_SECRET=                # any long random string (32+ characters); signs the login cookie
# COOKIE_SECURE=true           # set when served over https
# API_HOST=127.0.0.1
# FORWARDED_ALLOW_IPS=127.0.0.1   # proxies trusted for X-Forwarded-For; the container sets *
# API_PORT=8000
# INTAKE_WEBHOOK_SECRET=       # shared secret for the signed intake webhook; blank disables it

# --- spend (optional; amounts in micro-USD, 1,000,000 = $1) ---
# MONTHLY_CAPS_MICRO_USD={"zerobounce": 20000000}
# PROVIDER_PRICES={"hunter:find": 24500}

# --- logging ---
# LOG_LEVEL=INFO          # DEBUG, INFO, WARNING, ERROR or CRITICAL
# LOG_FORMAT=auto         # auto (readable on a terminal, JSON otherwise), json or console
# ENVIRONMENT=development # printed on every log line, for example production

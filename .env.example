# Copy to .env (git-ignored) and fill in. Blank means "not configured".
# Until the legacy agent/ package is deleted in Phase 2, agent/.env is also read as a fallback.

# --- database: flip DATABASE_BACKEND between the two; production uses postgres (Supabase) ---
DATABASE_BACKEND=sqlite
SQLITE_PATH=outbound.db
POSTGRES_URL=
# DATABASE_POOL_SIZE=5
# DATABASE_URL=     # set only to bypass the switch

# --- email waterfall providers (chain below is PROVISIONAL until the Phase 0 bake-off) ---
HUNTER_API_KEY=
ZEROBOUNCE_API_KEY=
ORBISEARCH_API_KEY=            # verifier only: OrbiSearch has no finder API
MYEMAILVERIFIER_API_KEY=
ENRICHLEY_API_KEY=             # catch-all resolver, answers in real time
SCRUBBY_API_KEY=               # catch-all resolver, answers in 24 to 72 hours
SCRUBBY_BASE_URL=              # not stated in Scrubby's public docs; copy it from your account

# --- search and research ---
TAVILY_API_KEY=
COMPANIES_HOUSE_API_KEY=       # free; confirms whether a UK lead is a registered company

# --- chain choice (comma-separated finders are tried in order) ---
FINDER_CHAIN=hunter,zerobounce
VERIFIER=myemailverifier
CATCH_ALL_RESOLVER=scrubby

# --- language model (any OpenAI-compatible endpoint) ---
# LLM_PROVIDER: anthropic | openai | gemini | ollama | github_copilot | openai_compatible
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5-5
LLM_BASE_URL=                  # only for openai_compatible (OpenRouter, Groq, Together, ...) or a proxy
# LLM_MAX_TOKENS=4000          # reasoning models think before answering; too low cuts the reply off
# LLM_REASONING_EFFORT=low     # low, medium or high, for a reasoning model that accepts it (OpenRouter);
#                              # blank sends nothing. Reasoning tokens count against LLM_MAX_TOKENS
# LLM_COPY_MODEL=              # a stronger model for writing the email; blank uses LLM_MODEL
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
COPILOT_API_KEY=
LLM_API_KEY=                   # for openai_compatible, or as a fallback for the others

# --- mailboxes (Phase 6c) ---
# Each workspace connects its own mailbox in Settings; nothing about a mailbox goes here.
# These are the platform's sign-in apps for Microsoft 365 and Google mailboxes (optional;
# without them only IMAP mailboxes can be connected). Redirect URI to register with both:
#   <APP_BASE_URL>/oauth/callback
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# --- stored secrets (Phase 6c) ---
# Encrypts the mailbox passwords and tokens each workspace connects. JSON {version: key};
# make a key with `uv run outbound secrets new-key`. To rotate: add a higher version, run
# `uv run outbound secrets rotate`, then drop the old key. Losing every key loses every
# connected mailbox (they reconnect from Settings).
SECRETS_KEYS=

# --- web app ---
# People sign in with an email and password. Make the first account with:
#   uv run outbound users create --email you@example.com --workspace <slug> --platform-role superadmin
# APP_BASE_URL=http://127.0.0.1:8000   # invitation and reset links start with it
# SUPERADMIN_ENABLED=true               # alpha only: a superadmin may read any workspace
# Invitations and password resets. Without SMTP_HOST they are printed to the log (refused
# in production). Postmark, Resend and Amazon SES all offer an SMTP relay.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# EMAIL_FROM=Outbound <no-reply@example.com>
# COOKIE_SECURE=true           # set when served over https
# API_HOST=127.0.0.1
# FORWARDED_ALLOW_IPS=127.0.0.1   # proxies trusted for X-Forwarded-For; the container sets *
# API_PORT=8000
# INTAKE_WEBHOOK_SECRET=       # shared secret for the signed intake webhook; blank disables it

# --- spend (optional; amounts in micro-USD, 1,000,000 = $1) ---
# MONTHLY_CAPS_MICRO_USD={"zerobounce": 20000000}
# PROVIDER_PRICES={"hunter:find": 24500}

# --- logging ---
# LOG_LEVEL=INFO          # DEBUG, INFO, WARNING, ERROR or CRITICAL
# LOG_FORMAT=auto         # auto (readable on a terminal, JSON otherwise), json or console
# ENVIRONMENT=development # printed on every log line, for example production

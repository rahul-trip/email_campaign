# Secrets only. Copy to agent/.env and fill in the values below.
# .env is gitignored — never commit it.
#
# This single file covers everything under agent/, including the mailer tool
# at agent/tools/mailer/ (it loads this same file — see
# agent/tools/mailer/config/settings.py).

# =============================================================================
# Data provider APIs (agent pipeline: discover -> resolve -> find -> verify)
# =============================================================================
TAVILY_API_KEY=       # Tavily Search API key (default discovery provider)
GOOGLE_CSE_KEY=       # Google Custom Search API key (only if providers.discovery: google_cse)
GOOGLE_CSE_CX=        # Custom Search Engine ID (only if providers.discovery: google_cse)
BRIGHTDATA_API_KEY=              # Bright Data API key (default contacts provider)
BRIGHTDATA_LINKEDIN_DATASET_ID=  # Bright Data dataset ID for the LinkedIn People Search collector in your account
PROXYCURL_API_KEY=    # Proxycurl API key (only if providers.contacts: proxycurl)
HUNTER_API_KEY=       # Hunter.io API key
NEVERBOUNCE_API_KEY=  # NeverBounce API key

# =============================================================================
# LLM copywriter (only needed when providers.copywriter is "llm" in config.yaml)
# Set the ONE key matching llm.provider:
# =============================================================================
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# COPILOT_API_KEY=      # for llm.provider: github_copilot
# (openai_compatible providers use whatever var name llm.key_env names)

# =============================================================================
# Mailer tool (agent/tools/mailer) — draft delivery via IMAP
# Only "imap" is implemented today. Switching to a different IMAP-based
# provider (Gmail, Outlook, Zoho, cPanel mail...) tomorrow means changing the
# values below, not any code. Switching to an OAuth-only API (Gmail API,
# Outlook Graph) means adding one new class under tools/mailer/drafts/ and
# changing PROVIDER_TYPE to match.
# =============================================================================
PROVIDER_TYPE=imap

# ---- IMAP connection (Hostinger today) ----
IMAP_HOST=imap.hostinger.com
IMAP_PORT=993
IMAP_USE_SSL=true

# ---- Mailbox credentials ----
EMAIL_ADDRESS=        # full mailbox address, e.g. sales@yourdomain.com
EMAIL_PASSWORD=       # mailbox password (use an app-specific password if 2FA is on)

# Exact IMAP folder to append drafts into. Varies by mailbox/IMAP layout —
# common values are "Drafts" or "INBOX.Drafts". Run
# `python -m agent.tools.mailer.scripts.list_folders` (from the project root)
# once credentials above are set, to see the exact name for your mailbox.
DRAFTS_FOLDER=Drafts

# Display name used in the "From" header of each draft, e.g. "Rahul, Quantra Energy".
FROM_NAME=

# ---- Campaign input ----
# Defaults to Quantra_Energy_Outbound_Campaign_Matrix.xlsx at the project root if unset.
XLSX_PATH=

# ---- Safety / throttling ----
# Seconds to sleep between each IMAP APPEND call — avoids tripping connection-
# rate limits on shared hosting mail servers.
DELAY_SECONDS=1
